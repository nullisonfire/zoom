# ==============================================================================
# Cloudflare Zoom Video Conferencing Application - Environment Configuration
# ==============================================================================

# Application Environment (development, preview, production)
ENVIRONMENT=development

# Frontend Application Origin (used for CORS and redirect URLs)
APP_URL=http://localhost:5173

# Cloudflare Account ID (available in Cloudflare Dashboard URL or Overview)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare D1 Database ID (created via: npx wrangler d1 create zoom-db)
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id

# Cloudflare Calls (Realtime SFU & TURN) Credentials
# Obtained from: Cloudflare Dashboard -> Calls -> Create App
CALLS_APP_ID=your_calls_app_id
CALLS_APP_SECRET=your_calls_app_secret

# Cloudflare R2 Bucket Name (created via: npx wrangler r2 bucket create zoom-media-storage)
R2_BUCKET_NAME=zoom-media-storage

# Cookie Secret for HMAC signing (optional additional session hardening)
COOKIE_SECRET=generate_a_random_32_byte_hex_string_here

# Cloudflare Realtime TURN credentials
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
